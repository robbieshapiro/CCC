{
  "name": "claude-country-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "check-holes": "rolldown scripts/check-holes.ts -o node_modules/.cache/check-holes.mjs -p node && node node_modules/.cache/check-holes.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "rolldown": "1.2.14"
  }
}
